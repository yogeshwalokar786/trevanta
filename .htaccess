<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block access to hidden files and directories (dotfiles like .git, .env, .htaccess)
    RewriteRule (^\.|/\.) - [F,L,NC]

    # Prevent direct access to sensitive files and database dumps
    RewriteRule ^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|README\.md|database\.sql|.*\.sql|.*\.sqlite|.*\.db) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|legacy_html)(/.*)?$ - [F,L,NC]

    # Block common malicious query injections (XSS / SQLi / Remote File Inclusion)
    RewriteCond %{QUERY_STRING} (eval\(|base64_encode|base64_decode|<script|GLOBALS|_REQUEST|_SERVER) [NC]
    RewriteRule .* - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect direct requests containing /public/ to clean URL without /public/
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Rewrite all other requests to the public directory
    RewriteCond %{REQUEST_URI} !public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Prevent directory listings
Options -Indexes

